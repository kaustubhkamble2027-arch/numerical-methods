print("Program for Simpson's 1/3 Rule:")
def f(x):
    return (1/(1+x**2))

lo = float(input("Enter the lower limit of integration:"))
up = float(input("Enter the upper limit of integration:"))
n = int(input("Enter the number of strips:"))

h = float((up - lo) / n)
print("Step size (h):", h)

sum = 0

for i in range(1, n):
    k = lo + i * h
    if i % 2 == 0:
        sum = sum + f(k) * 2
    else:
        sum = sum + f(k) * 4

sum = float((h / 3) * (sum + f(lo) + f(up)))

print("Answer:", sum)
print("End")
