import math


def f(x):
  return x**3-4*x-1


a = float(input("Enter first number (a): "))
b = float(input("Enter second number (b): "))

if f(a) * f(b) == 0:
  print("Either a or b is already the root.")
elif f(a) * f(b) > 0:
  print("No root lies in this interval.")
else:
  n = int(input("Enter number of iterations: "))

  for i in range(n):
    c = (a + b) / 2
    print(f"Iteration {i+1}: c = {c:.5f}, f(c) = {f(c):.5f}")

    if f(c) == 0:
      break
    elif f(a) * f(c) < 0:
      b = c
    else:
      a = c

  print(f"\nApproximate root: {c:.5f}")
